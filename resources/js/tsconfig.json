{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["Components/CheckybotDashboard/**/*.ts", "Components/CheckybotDashboard/**/*.tsx", "Pages/CheckybotDashboard/**/*.tsx"]
}
